# Cẩm nang Đà Nẵng. Copy this file to `.env.local` for development.
# Set public values at build time. Use the public origin without a trailing slash.
# Preview uses staging. Use production for the canonical, indexable site.
# Set NEXT_PUBLIC_APP_URL to https://dn-explorer.phanhoangquoctu.io.vn in production.

NEXT_PUBLIC_APP_ENV=development # production | staging | development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional backend origin for the Health page's posts demo and `/proxy/*` rewrite.
# Travel pages read the public workbook through the server-side connector.
NEXT_PUBLIC_API_URL="https://jsonplaceholder.typicode.com"

# Public footer contacts. Leave a contact value empty to hide its link.
NEXT_PUBLIC_OWNER_NAME="Phan Hoàng Quốc Tú"
NEXT_PUBLIC_OWNER_EMAIL=tuphan694@gmail.com
NEXT_PUBLIC_OWNER_FACEBOOK_URL=https://www.facebook.com/phanhoangquoctu/
NEXT_PUBLIC_OWNER_LINKEDIN_URL=https://www.linkedin.com/in/phanhoangquoctu/
